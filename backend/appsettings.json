{
  "FplApi": {
    "BaseUrl": "https://fantasy.premierleague.com/api/",
    "RequestTimeoutSeconds": 15,
    "BootstrapCacheMinutes": 60,
    "FixturesCacheMinutes": 15,
    "ManagerCacheMinutes": 5,
    "SquadCacheMinutes": 5,
    "PlayerHistoryCacheMinutes": 30
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=fpl;Username=fpl"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Persistence": {
    "RecommendationSnapshotMinutes": 15,
    "ApplyMigrations": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Security": {
    "UseHttpsRedirection": false,
    "RequestLimitPerMinute": 120,
    "MaxRequestBodyKilobytes": 64
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
